<Window x:Class="BPSRStreamKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPSR Stream Kit"
        Width="920" Height="620"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentGradient}">
                    <TextBlock Text="✦" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BPSR Stream Kit" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Portable • private by default" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="Refresh" Click="Refresh_Click"/>
                <Button Style="{StaticResource GhostButton}" Content="Settings" Click="Settings_Click" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Hero -->
        <Border Grid.Row="2" Padding="24" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,2,28,2">
                    <TextBlock x:Name="HeroTitle" Text="Ready to stream" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeroSubtitle"
                               Text="Open BPSR and Resonance Logs, then start Discord. The launcher handles the OBS setup for you."
                               Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="21"/>

                    <StackPanel x:Name="SetupProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <ProgressBar x:Name="SetupProgress" Height="5" Minimum="0" Maximum="100"
                                     Background="#252A36" Foreground="{StaticResource AccentBrush}" Value="0"/>
                        <TextBlock x:Name="SetupStatusText" Text="Preparing portable OBS…"
                                   Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Padding="16" CornerRadius="14" Background="#10131A">
                    <StackPanel>
                        <TextBlock Text="System check" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="2,0,0,10"/>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="ObsStatusDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ObsStatusText" Grid.Column="1" Text="OBS: checking…" FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,6,0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="GameStatusDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GameStatusText" Grid.Column="1" Text="BPSR: checking…" FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,6,0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="LogsStatusDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LogsStatusText" Grid.Column="1" Text="Resonance Logs: checking…" FontSize="13"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Primary action -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="DiscordButton" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                    Content="Start Discord" Click="Discord_Click" ToolTip="Open the prepared Discord scene in portable OBS"/>
            <Button x:Name="TwitchButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                    Content="Twitch" Click="Twitch_Click" ToolTip="Open the 1080p Twitch scene"/>
            <Button x:Name="TikTokButton" Grid.Column="4" Style="{StaticResource SecondaryButton}"
                    Content="TikTok" Click="TikTok_Click" ToolTip="Open the vertical TikTok scene"/>
        </Grid>

        <!-- How it works / platform hints -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="20" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="Discord" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="OBS combines BPSR, the DPS meter, Dungeon Mech HUD, your avatar and the thin frame. Other apps stay out of the capture."
                               Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="19"/>
                    <Border Margin="0,14,0,0" Padding="10,7" CornerRadius="9" Background="#11141B">
                        <TextBlock Text="After OBS opens: Discord → Share Screen → OBS Projector"
                                   FontSize="12" Foreground="#C9CEDA" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="20" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="Streaming services" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Twitch opens the same clean 1080p layout. TikTok opens a separate vertical layout. Account login or a stream key is still entered locally in OBS and is never stored in this project."
                               Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="19"/>
                    <TextBlock Text="Default output: 1080p • Simple mode • hardware encoder when available"
                               Margin="0,14,0,0" FontSize="12" Foreground="#C9CEDA" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Advanced drawer -->
        <Border x:Name="AdvancedPanel" Grid.Row="6" Grid.ColumnSpan="5"
                Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,0,0"
                Padding="18" Background="#1A1E28" BorderBrush="#343A49" BorderThickness="1" CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Advanced tools" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Use these only when something is wrong. Repair keeps account credentials and stream keys untouched."
                               Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Height="40" Width="110" Content="Open OBS" Click="OpenObs_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Height="40" Width="120" Content="Repair setup" Margin="10,0,0,0" Click="Repair_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="7" Margin="2,16,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatus" Text="No installer. No full-screen capture."
                       FontSize="11" Foreground="#6F7582" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="v0.1" FontSize="11" Foreground="#6F7582" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
