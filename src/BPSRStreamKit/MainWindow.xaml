<Window x:Class="BPSRStreamKit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StreamKit" Width="900" Height="650" MinWidth="840" MinHeight="610" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource AccentGradient}"><TextBlock Text="S" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="StreamKit" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="BPSR &amp; game streaming made simple" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource GhostButton}" Content="Refresh" Click="Refresh_Click"/><Button Style="{StaticResource GhostButton}" Content="Advanced" Click="Settings_Click" Margin="4,0,0,0"/></StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="STREAM TO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,7"/><Border Background="#10131A" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="13" Padding="3"><UniformGrid Columns="3"><Button x:Name="DiscordSegment" Style="{StaticResource SecondaryButton}" Height="38" Content="Discord" Click="DiscordSegment_Click" Margin="2"/><Button x:Name="TwitchSegment" Style="{StaticResource SecondaryButton}" Height="38" Content="Twitch" Click="TwitchSegment_Click" Margin="2"/><Button x:Name="TikTokSegment" Style="{StaticResource SecondaryButton}" Height="38" Content="TikTok" Click="TikTokSegment_Click" Margin="2"/></UniformGrid></Border></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="GAME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,7"/><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ComboBox x:Name="GameCombo" DisplayMemberPath="DisplayName" MinHeight="39" SelectionChanged="GameCombo_SelectionChanged"/><TextBlock x:Name="GameLayoutText" Text="Full layout · DPS + Dungeon HUD" Margin="2,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Scan games" Click="ScanGames_Click" Margin="8,0,0,0"/></Grid></Border></StackPanel>
    </Grid>

    <Border Grid.Row="4" Padding="22" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="HeroEyebrow" Text="READY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/><TextBlock x:Name="HeroTitle" Text="Ready to stream" Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="HeroSubtitle" Text="Choose a game and destination. StreamKit handles the private OBS scene for you." Margin="0,7,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="19"/><Button x:Name="MainActionButton" Style="{StaticResource PrimaryButton}" Content="Start Discord Stream" Margin="0,18,0,0" Click="MainAction_Click"/><TextBlock x:Name="ActionHint" Text="Game + Mic only · no desktop capture" Margin="2,8,0,0" FontSize="11" Foreground="#BDC3D0"/><StackPanel x:Name="SetupProgressPanel" Visibility="Collapsed" Margin="0,13,0,0"><ProgressBar x:Name="SetupProgress" Height="5" Minimum="0" Maximum="100" Background="#252A36" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="SetupStatusText" Margin="0,7,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
        <Border Grid.Column="2" Padding="16" CornerRadius="14" Background="#10131A"><StackPanel><TextBlock Text="READINESS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9"/><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="GameStatusDot" Width="8" Height="8"/><TextBlock x:Name="GameStatusText" Grid.Column="1" FontSize="12"/></Grid><Grid Margin="0,7,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="ObsStatusDot" Width="8" Height="8"/><TextBlock x:Name="ObsStatusText" Grid.Column="1" FontSize="12"/></Grid><Grid Margin="0,7,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="AvatarStatusDot" Width="8" Height="8"/><TextBlock x:Name="AvatarStatusText" Grid.Column="1" FontSize="12"/></Grid><Grid Margin="0,7,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="AudioStatusDot" Width="8" Height="8"/><TextBlock x:Name="AudioStatusText" Grid.Column="1" FontSize="12"/></Grid></StackPanel></Border>
      </Grid>
    </Border>

    <Border Grid.Row="6" Padding="15,12" Background="#10151C" BorderBrush="#26352F" BorderThickness="1" CornerRadius="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="10" Background="#163024"><TextBlock Text="✓" Foreground="{StaticResource GoodBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2"><TextBlock Text="Private capture is on" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="PrivacyText" Text="Only the selected game + your mic are included. Desktop, browser, Discord voices and notifications stay out." Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Grid></Border>

    <Border x:Name="AdvancedPanel" Grid.Row="7" Visibility="Collapsed" Margin="0,12,0,0" Padding="16" Background="#1A1E28" BorderBrush="#343A49" BorderThickness="1" CornerRadius="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Advanced settings" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="1080p · 60 FPS · hardware encoder when available" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Repair preserves your BPSR scene positions and local streaming account settings." FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="Open OBS" Click="OpenObs_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Open folder" Margin="8,0,0,0" Click="OpenFolder_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Repair" Margin="8,0,0,0" Click="Repair_Click"/></StackPanel></Grid></Border>

    <Grid Grid.Row="8" Margin="2,12,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterStatus" Text="No installer · no display capture" FontSize="11" Foreground="#6F7582"/><TextBlock Grid.Column="1" Text="v0.2.0" FontSize="11" Foreground="#6F7582"/></Grid>
  </Grid>
</Window>
