<UserControl x:Class="BPSRStreamKit.QuickLaunchCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="176">
    <Border Background="{StaticResource HeroGradient}"
            BorderBrush="#4A3C53"
            BorderThickness="1"
            CornerRadius="20"
            Padding="22"
            Margin="0,22,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <StackPanel MinWidth="0" VerticalAlignment="Center">
                <TextBlock Text="WELCOME BACK" Style="{StaticResource SectionLabel}" Foreground="{StaticResource GoodBrush}"/>
                <TextBlock x:Name="GameText"
                           Text="Your game"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusText"
                           Text="Your saved setup is ready."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           LineHeight="18"/>

                <UniformGrid Columns="3" Margin="0,16,0,0">
                    <Border Background="#121720" BorderBrush="#2B3340" BorderThickness="1" CornerRadius="12" Padding="11,9" Margin="0,0,6,0">
                        <StackPanel MinWidth="0">
                            <TextBlock Text="AVATAR" FontSize="9" Foreground="#7E8798"/>
                            <TextBlock x:Name="AvatarText" Text="Full VTuber" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#121720" BorderBrush="#2B3340" BorderThickness="1" CornerRadius="12" Padding="11,9" Margin="3,0">
                        <StackPanel MinWidth="0">
                            <TextBlock Text="FRAME" FontSize="9" Foreground="#7E8798"/>
                            <TextBlock x:Name="ThemeText" Text="Sakura" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#121720" BorderBrush="#2B3340" BorderThickness="1" CornerRadius="12" Padding="11,9" Margin="6,0,0,0">
                        <StackPanel MinWidth="0">
                            <TextBlock Text="SHARE TO" FontSize="9" Foreground="#7E8798"/>
                            <TextBlock x:Name="DestinationText" Text="Discord" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <Border Grid.Column="2" Background="#0E1219" BorderBrush="#28303D" BorderThickness="1" CornerRadius="15" Padding="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ONE-CLICK START" Style="{StaticResource SectionLabel}" TextAlignment="Center"/>
                    <Button x:Name="StartButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Start Discord Share"
                            Height="54"
                            Margin="0,10,0,0"
                            Click="StartButton_Click"
                            ToolTip="Use your remembered game, avatar, frame and sharing mode."/>
                    <TextBlock x:Name="ActionHint"
                               Text="StreamKit will reuse your saved setup."
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="3,8,3,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxHeight="44"/>
                    <Button Style="{StaticResource GhostButton}"
                            Content="Customize setup"
                            Margin="0,10,0,0"
                            Click="CustomizeButton_Click"
                            ToolTip="Show the full game, avatar, frame and destination choices."/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
